# Double Pendulum Simulation - Clean Working Version
import numpy as np
from scipy.integrate import solve_ivp
import matplotlib.pyplot as plt
from ipywidgets import interact, FloatSlider
%matplotlib widget

# Set up the figure
fig, ax = plt.subplots(figsize=(8, 8))
ax.set_xlim(-2.5, 2.5)
ax.set_ylim(-2.5, 2.5)
ax.set_aspect('equal')
ax.grid(True)
ax.set_title('Double Pendulum Simulation')

# Initialize pendulum elements
line, = ax.plot([], [], 'o-', lw=2, color='royalblue', markersize=8)
time_text = ax.text(0.02, 0.95, '', transform=ax.transAxes)

# Physics parameters
params = {
    'm1': 1.0, 'm2': 1.0,
    'l1': 1.0, 'l2': 1.0,
    'g': 9.81,
    'theta1': np.pi/2,
    'theta2': np.pi/2
}

# Simulation settings
simulation_duration = 10  # seconds
dt = 0.02
t_eval = np.arange(0, simulation_duration, dt)

# Differential equations
def double_pendulum(t, y, l1, l2, m1, m2, g):
    theta1, z1, theta2, z2 = y
    delta = theta2 - theta1
    
    den1 = (m1 + m2)*l1 - m2*l1*np.cos(delta)**2
    den2 = (l2/l1)*den1
    
    dtheta1 = z1
    dz1 = ((m2*l1*z1**2*np.sin(delta)*np.cos(delta) + 
           m2*g*np.sin(theta2)*np.cos(delta) + 
           m2*l2*z2**2*np.sin(delta) - 
           (m1 + m2)*g*np.sin(theta1)) / den1
    
    dtheta2 = z2
    dz2 = ((-m2*l2*z2**2*np.sin(delta)*np.cos(delta) + 
           (m1 + m2)*g*np.sin(theta1)*np.cos(delta) - 
           (m1 + m2)*l1*z1**2*np.sin(delta) - 
           (m1 + m2)*g*np.sin(theta2)) / den2
    
    return [dtheta1, dz1, dtheta2, dz2]

# Animation function
def animate(i):
    if not hasattr(animate, 'y') or i >= len(t_eval):
        return line, time_text
    
    theta1 = animate.y[0, i]
    theta2 = animate.y[2, i]
    
    x1 = params['l1'] * np.sin(theta1)
    y1 = -params['l1'] * np.cos(theta1)
    x2 = x1 + params['l2'] * np.sin(theta2)
    y2 = y1 - params['l2'] * np.cos(theta2)
    
    line.set_data([0, x1, x2], [0, y1, y2])
    
    max_len = max(params['l1'] + params['l2'], 5)
    ax.set_xlim(-max_len*1.2, max_len*1.2)
    ax.set_ylim(-max_len*1.2, max_len*1.2)
    
    time_text.set_text(f'Time: {t_eval[i]:.2f}s')
    return line, time_text

# Interactive controls
@interact(
    m1=FloatSlider(min=0.5, max=5.5, step=0.1, value=1.0, description='Mass 1'),
    m2=FloatSlider(min=0.5, max=5.5, step=0.1, value=1.0, description='Mass 2'),
    l1=FloatSlider(min=0.5, max=10.5, step=0.1, value=1.0, description='Length 1'),
    l2=FloatSlider(min=0.5, max=10.5, step=0.1, value=1.0, description='Length 2'),
    g=FloatSlider(min=0.1, max=20.0, step=0.1, value=9.81, description='Gravity')
)
def update_pendulum(m1, m2, l1, l2, g):
    params.update({'m1': m1, 'm2': m2, 'l1': l1, 'l2': l2, 'g': g})
    y0 = [params['theta1'], 0, params['theta2'], 0]
    sol = solve_ivp(double_pendulum, [0, simulation_duration], y0, t_eval=t_eval,
                   args=(params['l1'], params['l2'], params['m1'], params['m2'], params['g']), 
                   rtol=1e-6)
    animate.y = sol.y
    ani = FuncAnimation(fig, animate, frames=len(t_eval), interval=dt*1000, blit=True)
    plt.show()
